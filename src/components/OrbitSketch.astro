<figure class="orbit-sketch" data-orbit-sketch>
  <svg
    viewBox="0 0 340 300"
    role="img"
    aria-labelledby="orbit-title orbit-description"
  >
    <title id="orbit-title">An orbital sketch</title>
    <desc id="orbit-description">
      Three intersecting elliptical paths with points moving slowly around them.
    </desc>
    <defs>
      <radialGradient id="orbit-glow">
        <stop offset="0" stop-color="#d8c8a4" stop-opacity=".55" />
        <stop offset="1" stop-color="#d8c8a4" stop-opacity="0" />
      </radialGradient>
    </defs>
    <circle cx="170" cy="150" r="142" fill="url(#orbit-glow)" />
    <g fill="none" stroke="#b5a185" stroke-width=".7">
      <path d="M22 150h296M170 12v276" stroke-dasharray="2 7" />
      <circle cx="170" cy="150" r="139" stroke-dasharray="1 8" />
    </g>
    {[0, 60, 120].map((angle, i) => (
      <g transform={`rotate(${angle} 170 150)`}>
        <ellipse
          data-orbit-ring
          cx="170"
          cy="150"
          rx="125"
          ry="110"
          fill="none"
          stroke={["#968265", "#b29b7a", "#777855"][i]}
          stroke-width="1.1"
        />
        <circle
          data-orbit-point
          cx={170 + 125 * Math.cos(i * 2.1)}
          cy={150 + 110 * Math.sin(i * 2.1)}
          r={i === 0 ? 5 : 3.5}
          fill={["#77684d", "#9a765b", "#888e67"][i]}
        />
      </g>
    ))}
    <circle cx="170" cy="150" r="9" fill="#667953" />
    <circle cx="167" cy="147" r="2" fill="#bfcaa9" />
    <g stroke="#819172" stroke-width=".8">
      <path d="M36 53v8m-4-4h8M289 239v6m-3-3h6" />
    </g>
  </svg>
  <figcaption>An orbital sketch</figcaption>
</figure>
<script>
  const sketch = document.querySelector<HTMLElement>("[data-orbit-sketch]");
  if (sketch) {
    const points =
      sketch.querySelectorAll<SVGCircleElement>("[data-orbit-point]");
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0,
      phase = 0,
      previous = 0,
      running = false,
      visible = false;
    const tick = (time: number) => {
      if (!running) return;
      if (previous) phase += Math.min(time - previous, 50) * 0.00035;
      previous = time;
      points.forEach((point, i) => {
        const angle = phase * (1 + i * 0.18) + i * 2.1;
        point.setAttribute("cx", String(170 + 125 * Math.cos(angle)));
        point.setAttribute("cy", String(150 + 110 * Math.sin(angle)));
      });
      frame = requestAnimationFrame(tick);
    };
    const sync = () => {
      const shouldRun = visible && !document.hidden && !motion.matches;
      if (shouldRun === running) return;
      running = shouldRun;
      previous = 0;
      if (running) frame = requestAnimationFrame(tick);
      else cancelAnimationFrame(frame);
    };
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      sync();
    }).observe(sketch);
    document.addEventListener("visibilitychange", sync);
    motion.addEventListener("change", sync);
    window.addEventListener("pagehide", () => {
      visible = false;
      sync();
    });
    window.addEventListener("pageshow", () => {
      const rect = sketch.getBoundingClientRect();
      visible = rect.bottom > 0 && rect.top < innerHeight;
      sync();
    });
  }
</script>
