---
import { Icon } from "astro-iconify";
const { projects } = Astro.props;
---
<section class="grid grid-cols-1 md:grid-cols-2 gap-8">
  {projects.map(project => (
    <a href={`/projects/${project.slug}`} class="block group h-full">
      <div class="border hover:border-blue-500/50 dark:border-neutral-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 bg-white dark:bg-neutral-900/50 h-full flex flex-col items-start relative top-0 hover:-top-1">
        
        {project.data.heroImage && (
            <div class="w-full h-56 overflow-hidden">
                <img src={project.data.heroImage} alt={project.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
        )}
        
        <div class="p-8 flex flex-col flex-grow w-full">
          <div class="flex justify-between items-start w-full">
               <h2 class="text-2xl font-bold mb-3 group-hover:text-blue-500 transition-colors">{project.data.title}</h2>
               <Icon name="mdi:arrow-top-right" class="w-6 h-6 text-gray-300 group-hover:text-blue-500 transition-colors opacity-0 group-hover:opacity-100" />
          </div>
         
          <p class="text-gray-600 dark:text-gray-400 text-base mb-6 flex-grow leading-relaxed">
            {project.data.description}
          </p>
          {project.data.tags && (
            <div class="flex flex-wrap gap-2 mt-auto">
              {project.data.tags.slice(0, 4).map(tag => (
                <span class="text-xs font-medium bg-gray-100 dark:bg-neutral-800/80 px-2.5 py-1 rounded-md text-gray-700 dark:text-gray-300 border border-transparent dark:border-neutral-700">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </a>
  ))}
</section>
