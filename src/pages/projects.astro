---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
const projects = (await getCollection("projects")).sort(
  (a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0),
);
---

<SiteLayout title="Projects — Shubham Kumar">
  <section class="page-intro">
    <p class="small-label">Code & experiments</p>
    <h1>Things I’ve made.</h1>
    <p>Usually to solve a problem, sometimes to try an idea.</p>
  </section>
  <div class="entry-list">
    {projects.map((project) => (
      <a class="entry" href={`/projects/${project.slug}`}>
        <div>
          <span class="small-label">{project.data.tags?.join(" / ")}</span>
          <h2>{project.data.title}</h2>
          <p>{project.data.description}</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
  <p class="archive-end">
    More code on <a href="https://github.com/workdone0">GitHub ↗</a>
  </p>
</SiteLayout>
