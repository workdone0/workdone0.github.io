---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { Icon } from 'astro-iconify';

const skills = [
  "Python", "Backend & APIs", "Distributed Systems",
  "Data Processing", "Infrastructure", "Observability"
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="w-full max-w-screen-md mx-auto my-4 dark:bg-neutral-800 dark:text-neutral-300 transition-colors duration-300">
    <Header />
    <main class="flex flex-col justify-center px-4 md:px-0">
      
      {/* Hero Section */}
      <section class="flex flex-col gap-6 md:my-10 mb-20 relative">

        <script>
            const greetings = [
                "Hello",
                "नमस्ते",
                "Bonjour",
                "Hallo",
                "こんにちは"
            ];
            
            const typingSpeed = 150;
            const deletingSpeed = 75;
            const pauseTime = 2500;
            
            const greetingElement = document.getElementById('typing-greeting');
            
            let greetingIndex = 0;
            let charIndex = greetings[0].length;
            let isDeleting = false;
            
            function type() {
                const currentGreeting = greetings[greetingIndex];
                
                if (isDeleting) {
                    greetingElement.textContent = currentGreeting.substring(0, charIndex - 1);
                    charIndex--;
                } else {
                    greetingElement.textContent = currentGreeting.substring(0, charIndex + 1);
                    charIndex++;
                }
                
                let nextSpeed = isDeleting ? deletingSpeed : typingSpeed;
                
                if (!isDeleting && charIndex === currentGreeting.length) {
                    // Finished typing word
                    nextSpeed = pauseTime;
                    isDeleting = true;
                } else if (isDeleting && charIndex === 0) {
                    // Finished deleting word
                    isDeleting = false;
                    greetingIndex = (greetingIndex + 1) % greetings.length;
                    nextSpeed = 500;
                }
                
                setTimeout(type, nextSpeed);
            }
            
            // Start
            document.addEventListener('DOMContentLoaded', () => {
                // Set initial state to full word and start deleting after delay
                isDeleting = true;
                if(greetingElement) setTimeout(type, 1500);
            });
        </script>

        <h1 class="text-3xl md:text-6xl font-bold leading-tight z-10">
          Backend/Distributed systems engineer <span class="text-neutral-500 dark:text-neutral-400">building reliable software.</span>
        </h1>
        <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-400 max-w-2xl z-10 leading-relaxed">
          <span id="typing-greeting" class="inline-block border-r-2 border-neutral-800 dark:border-neutral-200 pr-1 animate-pulse">Hello</span>, I’m Shubham, a backend engineer specializing in distributed systems. I build software that scales without hiccups.
        </p>
        
        <div class="flex gap-4 mt-4 z-10">
          <a href="/projects" class="px-6 py-3 bg-neutral-900 dark:bg-white text-white dark:text-black font-semibold rounded-lg hover:opacity-90 transition">
            View Projects
          </a>
          <a href="https://workdone0.substack.com" target="_blank" class="px-6 py-3 border border-neutral-300 dark:border-neutral-700 font-semibold rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition">
            Read My Writing
          </a>
        </div>
      </section>



      <div class="grid md:grid-cols-2 gap-12 mb-20">
          {/* Skills / Tech Stack */}
          <section>
            <h2 class="text-xl font-semibold mb-4 text-neutral-900 dark:text-neutral-100">
                 The Stack
            </h2>
            <div class="flex flex-wrap gap-3">
                {skills.map(skill => (
                    <span class="px-3 py-1 rounded-full bg-neutral-100 dark:bg-neutral-800 text-sm text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700">
                        {skill}
                    </span>
                ))}
            </div>
          </section>

          {/* Online Presence */}
          <section>
             <h2 class="text-xl font-semibold mb-4 text-neutral-900 dark:text-neutral-100">
                 Connect
            </h2>
            <div class="flex flex-col gap-3">
                <a href="https://github.com/workdone0" target="_blank" class="flex items-center gap-3 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition group">
                    <Icon name="mdi:github" class="w-5 h-5 group-hover:scale-110 transition-transform" /> 
                    <span>GitHub</span>
                </a>
                <a href="https://www.linkedin.com/in/shubham-kumar-0199/" target="_blank" class="flex items-center gap-3 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition group">
                    <Icon name="mdi:linkedin" class="w-5 h-5 group-hover:scale-110 transition-transform" /> 
                    <span>LinkedIn</span>
                </a>
                <a href="https://workdone0.substack.com" target="_blank" class="flex items-center gap-3 text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition group">
                    <Icon name="mdi:fountain-pen-tip" class="w-5 h-5 group-hover:scale-110 transition-transform" /> 
                    <span>Substack</span>
                </a>
            </div>
          </section>
      </div>

    </main>
    <Footer />
  </body>
</html>
