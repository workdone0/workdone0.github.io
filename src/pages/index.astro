---
import SiteLayout from "../layouts/SiteLayout.astro";
import BotanicalSketch from "../components/BotanicalSketch.astro";
import FeynmanStory from "../components/FeynmanStory.astro";
import { writings, formatPostDate } from "../data/writings";
---

<SiteLayout>
  <section class="introduction">
    <div class="intro-copy">
      <p class="small-label">Hello, I’m</p>
      <h1>
        Shubham<span class="name-period">.</span>
      </h1>
      <p class="intro-lead">I write code. I like understanding things.</p>
      <p>
        Physics, astronomy, maths, computers, and everything in between. I don’t
        really have favourites. Almost anything gets interesting if you look
        deep enough.
      </p>
      <a class="quiet-link" href="/about">
        More about me <span aria-hidden="true">↗</span>
      </a>
    </div>
    <BotanicalSketch />
  </section>
  <section class="shelf-section" aria-labelledby="shelf-title">
    <div class="section-heading">
      <h2 id="shelf-title">A few things to open</h2>
      <span class="small-label">Pick something.</span>
    </div>
    <div class="shelf">
      <a class="shelf-item" href="/projects/twig">
        <div class="object-stage">
          <div class="mini-terminal" aria-hidden="true">
            <div class="terminal-top">
              <i></i>
              <i></i>
              <i></i>
              <span>twig</span>
            </div>
            <div class="terminal-lines">
              <span>❯ twig response.json</span>
              <span>▾ data</span>
              <span>　├─ ideas</span>
              <span>　└─ something useful_</span>
            </div>
          </div>
        </div>
        <div class="item-caption">
          <span class="small-label">Something I made</span>
          <h3>
            Twig <span>↗</span>
          </h3>
          <p>A way to stop getting lost in JSON.</p>
        </div>
      </a>
      <a class="shelf-item" href="/about#music" data-dialog="music-dialog">
        <div class="object-stage">
          <div class="record-sleeve" aria-hidden="true">
            <span class="sleeve-label">WORDS & MUSIC</span>
            <div class="record">
              <span></span>
            </div>
            <span class="sleeve-note">No single favourite.</span>
          </div>
        </div>
        <div class="item-caption">
          <span class="small-label">Something I like</span>
          <h3>
            A good line <span>↗</span>
          </h3>
          <p>A lot of feeling. A few words.</p>
        </div>
      </a>
      <a class="shelf-item" href="https://workdone0.substack.com/p/cosmos">
        <div class="object-stage">
          <div class="space-print" aria-hidden="true">
            <span class="print-top">A SMALL PERSPECTIVE</span>
            <svg viewBox="0 0 180 150" fill="none">
              <ellipse
                cx="90"
                cy="77"
                rx="75"
                ry="31"
                transform="rotate(-25 90 77)"
                stroke="#a8b3a7"
              />
              <circle cx="90" cy="77" r="30" fill="#647867" />
              <path d="M90 47C61 58 61 99 90 107" stroke="#b9c5b6" />
              <path
                d="M66 61C84 72 99 71 114 61M63 87C82 98 98 97 117 86"
                stroke="#94a38f"
              />
              <circle cx="151" cy="53" r="4" fill="#bbc4af" />
              <path d="M30 24v8m-4-4h8M142 116v6m-3-3h6" stroke="#abb8a4" />
            </svg>
            <span class="print-bottom">Shores of the Cosmic Ocean</span>
          </div>
        </div>
        <div class="item-caption">
          <span class="small-label">Something I wrote</span>
          <h3>
            A little perspective <span>↗</span>
          </h3>
          <p>On space, and our place in it.</p>
        </div>
      </a>
    </div>
  </section>
  <section class="home-writing" aria-labelledby="writing-title">
    <div class="section-heading">
      <div>
        <h2 id="writing-title">A little more reading</h2>
        <p>I write on Substack. The subjects vary.</p>
      </div>
      <a class="quiet-link" href="/writings">
        All writing ↗
      </a>
    </div>
    <div class="reading-list">
      {writings.slice(0, 3).map((post) => (
        <a href={post.url}>
          <span>{post.title}</span>
          <time class="reading-topic" datetime={post.date}>{formatPostDate(post.date)}</time>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
  <div class="last-note">
    <p>“Interest trumps experience.”</p>
    <span>Probably the simplest way to explain me.</span>
  </div>
  <dialog id="thought-dialog" aria-labelledby="thought-title">
    <div class="dialog-bar">
      <span class="small-label">Something I agree with</span>
      <form method="dialog">
        <button aria-label="Close passage">
          Close <span aria-hidden="true">×</span>
        </button>
      </form>
    </div>
    <div class="dialog-reading">
      <h2 id="thought-title">The beauty of a flower.</h2>
      <p class="dialog-intro">
        I like the idea that understanding something can make you appreciate it
        more. This passage says it better than I can.
      </p>
      <FeynmanStory />
    </div>
  </dialog>
  <dialog id="music-dialog" aria-labelledby="music-title">
    <div class="dialog-bar">
      <span class="small-label">Music</span>
      <form method="dialog">
        <button aria-label="Close music note">Close ×</button>
      </form>
    </div>
    <div class="dialog-reading music-note">
      <h2 id="music-title">It’s often the lyrics.</h2>
      <p>
        I listen to a wide variety of music. I don’t have one favourite song or
        artist.
      </p>
      <p>
        But good lyrics tend to get me. There’s something beautiful about
        communicating the most complicated feeling in a few words.
      </p>
      <p>
        That’s probably what I like most about music: someone finds the words
        for something that’s hard to explain.
      </p>
    </div>
  </dialog>
</SiteLayout>
<script>
  const openers = new WeakMap<HTMLDialogElement, HTMLAnchorElement>();
  for (const trigger of document.querySelectorAll<HTMLAnchorElement>(
    "[data-dialog]",
  )) {
    const dialog = document.getElementById(
      trigger.dataset.dialog ?? "",
    ) as HTMLDialogElement | null;
    if (!dialog || typeof dialog.showModal !== "function") continue;
    trigger.setAttribute("aria-haspopup", "dialog");
    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      openers.set(dialog, trigger);
      dialog.showModal();
    });
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      )
        dialog.close();
    });
    dialog.addEventListener("close", () => {
      if (openers.get(dialog) === trigger) trigger.focus({ preventScroll: true });
    });
  }
</script>
