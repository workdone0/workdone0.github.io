---
import SiteLayout from "../layouts/SiteLayout.astro";
import { writings, formatPostDate } from "../data/writings";
---

<SiteLayout title="Writing — Shubham Kumar">
  <section class="page-intro">
    <p class="small-label">On Substack</p>
    <h1>Writing.</h1>
    <p>A few things I’ve spent time thinking about.</p>
  </section>
  <div class="entry-list">
    {writings.map((post) => (
      <a class="entry" href={post.url}>
        <div>
          <time class="small-label" datetime={post.date}>{formatPostDate(post.date)}</time>
          <h2>{post.title}</h2>
          <p>{post.description}</p>
        </div>
        <span aria-label="Read on Substack">↗</span>
      </a>
    ))}
  </div>
  <p class="archive-end">
    I publish on <a href="https://workdone0.substack.com/">Substack</a>. You can{" "}
    <a href="https://workdone0.substack.com/subscribe">subscribe there</a> if
    you’d like new posts by email.
  </p>
</SiteLayout>
